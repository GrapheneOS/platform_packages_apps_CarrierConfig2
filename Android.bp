android_app {
    name: "CarrierConfig2",

    srcs: [
        "src/**/*.java",
        "src/**/*.proto",
    ],

    privileged: true,
    platform_apis: true,
    system_ext_specific: true,

    overrides: ["CarrierConfig"],

    static_libs: [
        "libprotobuf-java-lite",
    ],

    proto: {
        type: "lite",
    },

    required: [
        "etc_permissions_app.grapheneos.carrierconfig2.xml",
        "etc_sysconfig_app.grapheneos.carrierconfig2.xml",
    ],
}

prebuilt_etc {
    name: "etc_permissions_app.grapheneos.carrierconfig2.xml",
    src:  "etc/permissions/app.grapheneos.carrierconfig2.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "etc_sysconfig_app.grapheneos.carrierconfig2.xml",
    src:  "etc/sysconfig/app.grapheneos.carrierconfig2.xml",
    sub_dir: "sysconfig",
    filename_from_src: true,
    system_ext_specific: true,
}
